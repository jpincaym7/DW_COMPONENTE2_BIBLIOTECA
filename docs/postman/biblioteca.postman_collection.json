      "item": [
        {
          "name": "Registrar usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Entrega el token', () => pm.expect(body.data.token).to.be.a('string'));",
                  "pm.test('No expone la contrasena', () => pm.expect(body.data.user.password).to.be.undefined);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lector Nuevo\",\n  \"email\": \"lector.nuevo@biblioteca.com\",\n  \"password\": \"Lector1234\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
