    "name": "Biblioteca API",
    "description": "Coleccion completa de la API del sistema de gestion de biblioteca. Incluye el camino feliz y los casos de error (401, 403, 400, 404, 409).\n\nOrden de uso: ejecute la carpeta 00 - Autenticacion primero. El login guarda automaticamente los tokens en el entorno.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('La respuesta sigue el contrato de la API', function () {",
          "  const body = pm.response.json();",
          "  pm.expect(body).to.have.property('success');",
          "  pm.expect(body).to.have.property('message');",
          "});"
        ]
      }
    }
  ],
